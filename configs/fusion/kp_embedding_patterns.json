    {
      "name": "kp_sparse_select",
      "kernel": "fused_kp_sparse_select",
      "abi": "annc_execution_v2",
      "priority": 180,
      "graph": [
        "x = Reshape(a)",
        "b_column = Reshape(b)",
        "c_column = Reshape(c)",
        "greater = Compare(x, gt)",
        "greater_value = Cast(greater)",
        "b_shape_0 = Shape(b_column)",
        "b_fill_0 = Fill(b_shape_0)",
        "equal_0 = Compare(b_column, eq1)",
        "select_1 = Where(equal_0, b_fill_0, greater_value)",
        "equal_1 = Compare(b_column, eq2)",
        "b_shape_1 = Shape(b_column)",
        "b_fill_1 = Fill(b_shape_1)",
        "y = Where(equal_1, b_fill_1, select_1)",
        "equal_2 = Compare(c_column, eq3)",
        "c_shape_0 = Shape(c_column)",
        "c_shape_1 = Shape(c_column)",
        "c_fill_0 = Fill(c_shape_0)",
        "c_fill_1 = Fill(c_shape_1)",
        "select_2 = Where(equal_2, c_fill_1, c_fill_0)",
        "empty = Fill()",
        "w = ConcatV2(y, select_2, empty)"
      ],
      "inputs": ["a", "b", "c", "gt", "eq1", "eq2", "eq3"],
      "outputs": ["x", "y", "w"],
      "where": [
        "greater.comparisonDirection == \"GT\"",
        "equal_0.comparisonDirection == \"EQ\"",
        "equal_1.comparisonDirection == \"EQ\"",
        "equal_2.comparisonDirection == \"EQ\"",
        "rank(a) == 1",
        "rank(b) == 1",
        "rank(c) == 1",
        "rank(gt) == 0",
        "rank(eq1) == 0",
        "rank(eq2) == 0",
        "rank(eq3) == 0"
      ]
