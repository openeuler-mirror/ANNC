{
  "version": 1,
  "patterns": [
    {
      "name": "kp_fused_gather_external",
      "kernel": "fused_kp_fused_gather_external",
      "abi": "annc_execution_v2",
      "graph": [
        "slice = StridedSlice(keys, begin)",
        "(first_unique, first_unique_indices) = Unique(slice)",
        "(second_unique, second_unique_indices) = Unique(first_unique)",
        "inner_gather = Gather(data, second_unique)",
        "outer_gather = Gather(inner_gather, second_unique_indices)"
      ],
      "inputs": ["data", "keys", "begin"],
      "outputs": ["first_unique", "first_unique_indices", "outer_gather"],
      "where": [
        "inner_gather.batch_dims == 0",
        "outer_gather.batch_dims == 0",
        "slice.beginMask == 1",
        "slice.endMask == 1",
        "slice.ellipsisMask == 0",
        "slice.newAxisMask == 0",
        "slice.shrinkAxisMask == 2",
        "rank(data) == 2",
        "rank(keys) == 2",
        "rank(begin) == 1",
        "rank(first_unique) == 1",
        "rank(first_unique_indices) == 1",
        "rank(outer_gather) == 2"
      ]
    }
  ]
}
