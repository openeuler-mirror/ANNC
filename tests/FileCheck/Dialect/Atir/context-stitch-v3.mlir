// RUN: annc-asm %s --atir-fast-codegen --lower-context-kernel-entries --convert-atir-to-linalg | FileCheck %s
// N16 has 17 tensors at the semantic boundary and one context at runtime.
// CHECK-LABEL: func.func private @context_stitch_n16(
// CHECK-SAME: %[[CTX:[A-Za-z0-9_]+]]: !llvm.ptr) -> i32
// CHECK: call @ANNCKernel_ContextV3_KPFusedSparseDynamicStitch_float_auto(%[[CTX]]) : (!llvm.ptr) -> i32
module {
  func.func private @context_stitch_n16(%x: !atir.tensor<?xi64>, %variable_0: !atir.tensor<2x2xf32>, %variable_1: !atir.tensor<2x2xf32>, %variable_2: !atir.tensor<2x2xf32>, %variable_3: !atir.tensor<2x2xf32>, %variable_4: !atir.tensor<2x2xf32>, %variable_5: !atir.tensor<2x2xf32>, %variable_6: !atir.tensor<2x2xf32>, %variable_7: !atir.tensor<2x2xf32>, %variable_8: !atir.tensor<2x2xf32>, %variable_9: !atir.tensor<2x2xf32>, %variable_10: !atir.tensor<2x2xf32>, %variable_11: !atir.tensor<2x2xf32>, %variable_12: !atir.tensor<2x2xf32>, %variable_13: !atir.tensor<2x2xf32>, %variable_14: !atir.tensor<2x2xf32>, %variable_15: !atir.tensor<2x2xf32>) -> !atir.tensor<?x2xf32> attributes {annc.kernel, fusion.metadata = {abi = "annc_context_v3", context_i64_attrs = [16]}} {
    %result = atir.Customize(%x, %variable_0, %variable_1, %variable_2, %variable_3, %variable_4, %variable_5, %variable_6, %variable_7, %variable_8, %variable_9, %variable_10, %variable_11, %variable_12, %variable_13, %variable_14, %variable_15) {opType = "KPFusedSparseDynamicStitch", metadata = {custom.arg_kinds = ["memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "memref", "i64_attr"], custom.arg_names = ["x", "variable_0", "variable_1", "variable_2", "variable_3", "variable_4", "variable_5", "variable_6", "variable_7", "variable_8", "variable_9", "variable_10", "variable_11", "variable_12", "variable_13", "variable_14", "variable_15", "N"], custom.arg_ranks = [1, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2, -1], custom.arg_type_vars = ["", "T", "T", "T", "T", "T", "T", "T", "T", "T", "T", "T", "T", "T", "T", "T", "T", ""], custom.attr_values = [16], custom.op_name = "KPFusedSparseDynamicStitch", custom.result_names = ["output"], custom.result_ranks = [2], custom.result_type_vars = ["T"], custom.type_vars = ["T"]}} : (!atir.tensor<?xi64>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>, !atir.tensor<2x2xf32>) -> !atir.tensor<?x2xf32>
    return %result : !atir.tensor<?x2xf32>
  }
}
