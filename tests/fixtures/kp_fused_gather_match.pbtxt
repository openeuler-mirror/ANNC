  attr { key: "T" value { type: DT_INT64 } }
  attr { key: "Index" value { type: DT_INT32 } }
  attr { key: "begin_mask" value { i: 1 } }
  attr { key: "ellipsis_mask" value { i: 0 } }
  attr { key: "end_mask" value { i: 1 } }
  attr { key: "new_axis_mask" value { i: 0 } }
  attr { key: "shrink_axis_mask" value { i: 2 } }
  attr {
    key: "_output_shapes"
    value { list { shape { dim { size: 4 } } } }
  }
}
node {
